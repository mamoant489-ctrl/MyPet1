<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8E1"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Динамика данных"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- ВЕС -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCurrentWeight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="15.2 кг"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWeightChange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📈 +0.3"
                android:textSize="18sp" />

        </LinearLayout>

        <com.example.mypet.LineChartView
            android:id="@+id/chartWeight"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#FFF5EE"
            android:layout_marginTop="8dp"
            android:padding="16dp" />

    </LinearLayout>

    <!-- РОСТ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCurrentHeight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="55.0 см"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeightChange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📉 -0.5"
                android:textSize="18sp" />

        </LinearLayout>

        <com.example.mypet.LineChartView
            android:id="@+id/chartHeight"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#FFF5EE"
            android:layout_marginTop="8dp"
            android:padding="16dp" />

    </LinearLayout>

</LinearLayout>
