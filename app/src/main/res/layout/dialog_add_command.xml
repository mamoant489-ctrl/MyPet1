<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFF3E8"
    android:minWidth="300dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Добавить команду"
        android:textColor="#3A1F0F"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:boxStrokeColor="#D4A284"
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="#FFFFFF"
        app:hintTextColor="#8B4513">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCommandName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Сидеть, Лежать, Дай лапу..."
            android:textSize="16sp"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Добавить команду"
        android:textSize="16sp"
        app:backgroundTint="#D4A284"
        app:cornerRadius="12dp" />

</LinearLayout>
